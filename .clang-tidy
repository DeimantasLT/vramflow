# SPDX-License-Identifier: Apache-2.0
#
# Statinė analizė (planas docs/planai/2026-11-17-production-ready.md §2.4, kriterijus K3).
# Paleidimas: scripts/linux/55-clang-tidy.sh — visi src/ vertimo vienetai, išskyrus .cu (juos kompiliuoja nvcc).
# Priėmimas: 0 radinių šiame rinkinyje.
#
# Rinkinys: klaidų, saugumo (CERT), gijų ir našumo tikrinimai bei statinis analizatorius. Stiliaus tikrinimų nėra.
# Tikrinimas išjungiamas tik čia ir tik su priežastimi šalia (skaičiai — bazė 2026-11-17, 480 radinių 62 vienetuose,
# docs/rezultatai/2026-11-17-production-ready-faze2.md §2.4). Radinio slopinimas kode (NOLINT) — tik su priežastimi toje
# pačioje eilutėje.
#
# Išjungta:
#   bugprone-easily-swappable-parameters (97) — žymi kiekvieną (w, h), (x, y), (num, den) porą; ištaisoma tik stipriais
#       tipais visose sąsajose, o tai ne defektas, kurį galima pataisyti vietoje.
#   bugprone-implicit-widening-of-multiplication-result (84) — visi radiniai yra indeksai eilutės viduje (konstanta ×
#       grupės ar pikselio numeris: 16 * g, 3 * i, ly * lw). Rastro matmenys riboti formato patikra (≤ 7680 × 4320;
#       fuzz invariantas tests/fuzz), todėl int neperpildomas; eilutė × pitch visur jau skaičiuojama size_t.
#   performance-enum-size (20) — siūlo enum : uint8_t; viešos C antraštės include/vramflow/gfx.h enum'ų keisti negalima
#       (ABI), o kiti masyvuose nelaikomi — naudos nėra.
#   clang-analyzer-optin.performance.Padding (3) — laukų pertvarkymas dėl užpildo (Opts, vfgfx_writer_s, SourceClock):
#       laukai sugrupuoti pagal prasmę, objektų po vieną procese.
#   cert-dcl50-cpp (1, atsirado su taisymais) — vienintelė C stiliaus kintamo argumentų skaičiaus funkcija yra
#       mxlv::strf (src/common/textf.hpp): printf formatas su [[gnu::format]], todėl kompiliatorius patikrina kiekvieno
#       kvietimo formatą ir argumentus. Parametrų paketo variantas tos patikros netektų.
Checks: >-
  -*,
  bugprone-*,
  cert-*,
  concurrency-*,
  performance-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -performance-enum-size,
  -clang-analyzer-optin.performance.Padding,
  -cert-dcl50-cpp
WarningsAsErrors: ''
# Tik mūsų antraštės (MXL, CUDA, vcpkg ir sisteminės — ne). Skriptas šį filtrą pakeičia tiksliu repo keliu.
HeaderFilterRegex: '(^|/)(src/(common|engine|func|gfx|gpu|ingest|media|mxlio|runtime|timing)|include/vramflow)/'
FormatStyle: none
CheckOptions:
  # Tikslinė platforma — Linux su glibc. POSIX rinkinys papildomai žymi getenv (5) ir readdir (3), kuriuos glibc
  # dokumentuoja kaip saugius mūsų naudojimui (aplinka nekeičiama; kiekvienas DIR srautas — vienos gijos).
  concurrency-mt-unsafe.FunctionSet: glibc
  # Tuščias catch leidžiamas tik C sąsajos riboje ir tik su komentaru „C ABI:“ (išimtis per bibliotekos ribą nepraleidžiama).
  bugprone-empty-catch.IgnoreCatchWithKeywords: '@TODO;@FIXME;C ABI:'
  # CERT sąrašas be fprintf, fputc, fputs, putc, vfprintf. Tai išvedimo funkcijos, kurių klaida lieka srauto būsenoje:
  # diagnostikai į stderr jos nėra kam pranešti (69 iš 80 kvietimų), o rašant į failą ji patikrinama uždarant —
  # fclose ir fflush sąraše lieka (src/common/textf.hpp: close_checked).
  cert-err33-c.CheckedFunctions: '^::aligned_alloc;^::asctime_s;^::at_quick_exit;^::atexit;^::bsearch;^::bsearch_s;^::btowc;^::c16rtomb;^::c32rtomb;^::calloc;^::clock;^::cnd_broadcast;^::cnd_init;^::cnd_signal;^::cnd_timedwait;^::cnd_wait;^::ctime_s;^::fclose;^::fflush;^::fgetc;^::fgetpos;^::fgets;^::fgetwc;^::fopen;^::fopen_s;^::fprintf_s;^::fputwc;^::fputws;^::fread;^::freopen;^::freopen_s;^::fscanf;^::fscanf_s;^::fseek;^::fsetpos;^::ftell;^::fwprintf;^::fwprintf_s;^::fwrite;^::fwscanf;^::fwscanf_s;^::getc;^::getchar;^::getenv;^::getenv_s;^::gets_s;^::getwc;^::getwchar;^::gmtime;^::gmtime_s;^::localtime;^::localtime_s;^::malloc;^::mbrtoc16;^::mbrtoc32;^::mbsrtowcs;^::mbsrtowcs_s;^::mbstowcs;^::mbstowcs_s;^::memchr;^::mktime;^::mtx_init;^::mtx_lock;^::mtx_timedlock;^::mtx_trylock;^::mtx_unlock;^::printf_s;^::putwc;^::raise;^::realloc;^::remove;^::rename;^::scanf;^::scanf_s;^::setlocale;^::setvbuf;^::signal;^::snprintf;^::snprintf_s;^::sprintf;^::sprintf_s;^::sscanf;^::sscanf_s;^::strchr;^::strerror_s;^::strftime;^::strpbrk;^::strrchr;^::strstr;^::strtod;^::strtof;^::strtoimax;^::strtok;^::strtok_s;^::strtol;^::strtold;^::strtoll;^::strtoul;^::strtoull;^::strtoumax;^::strxfrm;^::swprintf;^::swprintf_s;^::swscanf;^::swscanf_s;^::thrd_create;^::thrd_detach;^::thrd_join;^::thrd_sleep;^::time;^::timespec_get;^::tmpfile;^::tmpfile_s;^::tmpnam;^::tmpnam_s;^::tss_create;^::tss_get;^::tss_set;^::ungetc;^::ungetwc;^::vfprintf_s;^::vfscanf;^::vfscanf_s;^::vfwprintf;^::vfwprintf_s;^::vfwscanf;^::vfwscanf_s;^::vprintf_s;^::vscanf;^::vscanf_s;^::vsnprintf;^::vsnprintf_s;^::vsprintf;^::vsprintf_s;^::vsscanf;^::vsscanf_s;^::vswprintf;^::vswprintf_s;^::vswscanf;^::vswscanf_s;^::vwprintf_s;^::vwscanf;^::vwscanf_s;^::wcrtomb;^::wcschr;^::wcsftime;^::wcspbrk;^::wcsrchr;^::wcsrtombs;^::wcsrtombs_s;^::wcsstr;^::wcstod;^::wcstof;^::wcstoimax;^::wcstok;^::wcstok_s;^::wcstol;^::wcstold;^::wcstoll;^::wcstombs;^::wcstombs_s;^::wcstoul;^::wcstoull;^::wcstoumax;^::wcsxfrm;^::wctob;^::wctrans;^::wctype;^::wmemchr;^::wprintf_s;^::wscanf;^::wscanf_s'
